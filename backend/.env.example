# =====================================================================
# SkillRadar Backend Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git (already in .gitignore)
# =====================================================================

# --- Flask Configuration ---
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=change-this-to-any-random-string

# --- Database (Supabase PostgreSQL) ---
# Use the POOLER URL (not direct), especially from Indian ISPs
# URL-encode @ in password as %40
# Example: postgresql://postgres.ref:Pass%40123@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# --- Supabase API ---
# Find these in Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# --- Adzuna API ---
# Free tier: 250 calls/month
# Get keys at: https://developer.adzuna.com/
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# --- RapidAPI (for JSearch — LinkedIn/Indeed/Glassdoor) ---
# Free tier: 200 calls/month
# Get key at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your_rapidapi_key_here

# --- Jooble API ---
# Free, host-restricted (whitelist localhost in dashboard)
# Get key at: https://jooble.org/api/about
JOOBLE_API_KEY=your_jooble_key_here

# --- Groq AI (for resume tailoring & chat) ---
# Free tier: 14,400 calls/day, Llama 3.1 70B
# Get key at: https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# --- Cache ---
CACHE_DIR=./cache
CACHE_TTL_HOURS=6
